# توکن ربات تلگرام (از @BotFather) — نام متغیر عمداً همان "Token" نگه داشته شده
# تا با استقرارهای فعلی سازگار بماند.
Token=123456789:AAExampleTokenReplaceWithYourOwnFromBotFather

# کلید API سرویس Gemini (از Google AI Studio)
GEMINI_API_KEY=AQ.ExampleReplaceWithYourOwnKeyFromAIStudio

# شناسه‌ی چت ادمین‌ها — لیستی جدا‌شده با کاما، بدون فاصله‌ی اضافه لازم نیست:
# ADMIN_CHAT_ID=1111111111,2222222222
ADMIN_CHAT_ID=123456789

# --- اختیاری (پیش‌فرض‌ها مطابق نسخه‌ی قبلی است؛ فقط در صورت نیاز تغییر دهید) ---
# USERS_DB_PATH=users.db
# EQUIPMENT_DB_PATH=medical_device.db

# --- فاز ۴: زنجیره‌ی fallback چندمدله‌ی هوش مصنوعی ---
# کلید Groq (console.groq.com) — لایه‌ی دوم زنجیره. اگر خالی بماند، این لایه
# به‌سادگی رد می‌شود و مستقیم به لایه‌ی بعدی می‌رود.
GROQ_API_KEY=gsk_ExampleReplaceWithYourOwnKeyFromConsoleGroqCom

# کلید OpenRouter (openrouter.ai) — لایه‌ی سوم/آخر زنجیره (fallback نهایی).
OPENROUTER_API_KEY=sk-or-v1-ExampleReplaceWithYourOwnKeyFromOpenRouter

# اختیاری: بازنویسی مدل اصلی و/یا زنجیره‌ی fallback بدون نیاز به لمس کد.
# فرمت مدل‌ها به سبک LiteLLM است: "provider/model"، با کاما از هم جدا.
# پیش‌فرض فعلی (اگر این دو خط خالی/کامنت بمانند):
#   اصلی:    gemini/gemini-2.5-flash
#   fallback: groq/openai/gpt-oss-120b, groq/qwen/qwen3.6-27b,
#             openrouter/meta-llama/llama-3.3-70b-instruct:free
# نکته: فهرست مدل‌های رایگان Groq/OpenRouter به‌کرات تغییر می‌کند — قبل از
# اعتماد کامل به این‌ها، در کنسول هرکدام (console.groq.com/docs/models و
# openrouter.ai/models با فیلتر :free) بررسی کنید که هنوز فعال‌اند.
# AI_PRIMARY_MODEL=gemini/gemini-2.5-flash
# AI_FALLBACK_MODELS=groq/openai/gpt-oss-120b,groq/qwen/qwen3.6-27b,openrouter/meta-llama/llama-3.3-70b-instruct:free

# --- فاز ۵: زنجیره‌ی OCR فارسی (تبدیل عکس به متن) ---
# کلید Google Cloud Vision — لایه‌ی اول (بهترین دقت مستند برای فارسی چاپی).
# از Google Cloud Console یک API key بسازید (نیازی به service account JSON
# نیست) و Vision API را برای پروژه‌تان فعال کنید. ۱۰۰۰ واحد/ماه رایگان
# دائمی.
GOOGLE_VISION_API_KEY=AQ.ExampleReplaceWithYourOwnKeyFromGoogleCloudConsole

# کلید و آدرس Azure AI Vision — لایه‌ی دوم. endpoint مخصوص همان منبعی است که
# در پورتال Azure می‌سازید (چیزی شبیه https://<resource-name>.cognitiveservices.azure.com).
# ردیف رایگان F0: ۵۰۰۰ تراکنش/ماه.
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# --- تبدیل ویس به متن (زنجیره‌ی fallback ۸لایه‌ی STT فارسی) ---
# هر کلید نبود، همان لایه به‌سادگی رد می‌شود و به لایه‌ی بعدی می‌رود — هیچ‌کدام
# اجباری نیست. ترتیب پیش‌فرض (قابل تغییر با STT_PROVIDER_ORDER، بدون لمس کد):
#   elevenlabs → groq → deepgram → assemblyai → azure → google → wit → google_unofficial
# پیش‌نیاز سیستمی: ffmpeg باید روی سرور نصب باشد (`apt install ffmpeg`) —
# فقط لایه‌های azure و google_unofficial از آن استفاده می‌کنند (تبدیل OGG→WAV).

# ElevenLabs (elevenlabs.io) — لایه‌ی اول، بهترین دقت. سهمیه‌ی رایگان کوچک
# و بین همه‌ی کاربرهای بات مشترک است (نه هرکاربر جدا).
ELEVENLABS_API_KEY=

# GROQ_API_KEY از قبل بالاتر برای زنجیره‌ی AI تعریف شده و همان کلید برای
# لایه‌ی دوم STT (Whisper large-v3) هم استفاده می‌شود — نیازی به کلید جدا نیست.

# Deepgram (deepgram.com) — لایه‌ی سوم، credit یک‌باره‌ی $200.
DEEPGRAM_API_KEY=

# AssemblyAI (assemblyai.com) — لایه‌ی چهارم، credit یک‌باره‌ی $50.
ASSEMBLYAI_API_KEY=

# Azure AI Speech (portal.azure.com) — لایه‌ی پنجم، ردیف رایگان F0: ۵ ساعت/ماه.
# جدا از AZURE_VISION_KEY بالا — این یک منبع Azure دیگر (Speech، نه Vision) است.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud Speech-to-Text (console.cloud.google.com) — لایه‌ی ششم، ۶۰
# دقیقه/ماه رایگان (نیاز به فعال‌سازی billing). جدا از GOOGLE_VISION_API_KEY
# بالا — این یک API مستقل (Speech-to-Text، نه Vision) است.
GOOGLE_STT_API_KEY=

# wit.ai (wit.ai، مال Meta) — لایه‌ی هفتم، کاملاً رایگان بدون سقف مستند.
WIT_AI_TOKEN=

# لایه‌ی هشتم/آخر (google_unofficial) به هیچ کلیدی نیاز ندارد — از یک
# endpoint غیررسمی از طریق پکیج SpeechRecognition استفاده می‌کند.

# اختیاری: بازنویسی ترتیب زنجیره‌ی STT بدون لمس کد (نام‌ها دقیقاً باید
# یکی از ۸ مورد بالا باشند، با کاما جدا):
# STT_PROVIDER_ORDER=elevenlabs,groq,deepgram,assemblyai,azure,google,wit,google_unofficial

# --- کوییز از متن و ویس‌استاد-به-جزوه ---
# هیچ کلید جدیدی لازم ندارند - از همون GEMINI_API_KEY/GROQ_API_KEY بالا
# (زنجیره‌ی AI) و کلیدهای STT بالا استفاده می‌کنند.

